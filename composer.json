{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/laravel-tax",
    "description": "Cbox Tax \u2014 a self-hostable consumption-tax engine for Laravel: it owns the calculation logic (place-of-supply, reverse-charge, rate application, inclusive/exclusive) per jurisdiction and sources rate and rule data through pluggable contracts.",
    "keywords": [
        "cbox",
        "tax",
        "vat",
        "gst",
        "sales-tax",
        "eu-vat",
        "reverse-charge",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-zlib": "*",
        "brick/money": "^0.14 || ^0.15",
        "cboxdk/laravel-geo": "^0.6",
        "cboxdk/tax-resolver": "^1.1",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "rector/rector": "2.6.7"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Tax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Tax\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "refactor": "rector process",
        "refactor:check": "rector process --dry-run --no-progress-bar",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "test:reference": "pest --group=reference",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@refactor:check",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev"
        ],
        "sbom-check": [
            "@sbom",
            "git diff --exit-code sbom.json"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Tax\\TaxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
